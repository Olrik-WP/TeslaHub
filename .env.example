# ─── TeslaMate (existing — must match your current TeslaMate config) ───
TM_ENCRYPTION_KEY=your_teslamate_encryption_key
TM_DB_USER=teslamate
TM_DB_PASS=your_teslamate_db_password
TM_DB_NAME=teslamate
TZ=Europe/Paris

# ─── TeslaHub ─────────────────────────────────────────────────
# Passwords for auto-created database users (choose strong ones)
TESLAHUB_READER_PASS=choose_a_strong_password_1
TESLAHUB_APP_PASS=choose_a_strong_password_2

# Admin login for TeslaHub web interface
TESLAHUB_ADMIN_USER=admin
TESLAHUB_ADMIN_PASSWORD=choose_a_strong_password_3

# Session duration in days (browser stays logged in)
TESLAHUB_SESSION_DAYS=30

# JWT signing secret (generate with: openssl rand -hex 32)
TESLAHUB_JWT_SECRET=generate_a_64_char_random_string_here

# Map tiles (default = OpenStreetMap, change for custom tile server)
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# IP restriction (optional — empty = allow all, CIDR or comma-separated)
# TESLAHUB_ALLOWED_IPS=192.168.1.0/24

# ─── MQTT (optional — enables live vehicle status) ────────────
# Required for: door/trunk/frunk/window status, lock state,
# Sentry Mode, TPMS warnings, preconditioning, climate keeper.
# Without MQTT, TeslaHub still works but these live features are disabled.
#
# IMPORTANT: your TeslaMate must NOT have DISABLE_MQTT=true.
# You also need a Mosquitto broker in your stack.
# See README.md for details.
MQTT_HOST=mosquitto
MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASSWORD=
# MQTT_NAMESPACE=

# ─── Dynamic load shedding (optional, configured from the UI) ─
# The load-shedding engine subscribes to ANY MQTT topic publishing
# whole-house power (ZLinky FR via Zigbee2MQTT, Shelly EM, Tasmota, P1
# reader NL/BE, IoTaWatt US, Emporia, …) and throttles set_charging_amps
# via the Tesla Fleet API when the house approaches the breaker /
# contract limit. NO env vars to set: topic, JSON field path (dot
# notation supported), display unit, scale factor and thresholds live
# in the database and are edited from Settings → Tesla integration →
# Dynamic load shedding. The engine reuses the MQTT_* broker above.
# Defaults match a French ZLinky in standard TIC mode (topic
# zigbee2mqtt/Lixee, field apparent_power, unit VA, scale 1).
