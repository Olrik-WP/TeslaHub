:80 {
	root * /srv
	encode gzip

	handle /api/* {
		reverse_proxy teslahub-api:8080
	}

	# Tesla Fleet API requires this path to serve the partner public key.
	# Forward to the API container which generates and exposes it.
	handle /.well-known/appspecific/* {
		reverse_proxy teslahub-api:8080
	}

	# Optional 3D vehicle models. Mounted as a bind volume by operators who
	# own the assets. Serve them with aggressive caching (immutable filename
	# pattern) and return a proper 404 instead of falling through to
	# index.html, so the frontend's HEAD probe can detect absence reliably.
	#
	# IMPORTANT: only attach the long-cache header on SUCCESSFUL responses
	# (matcher @models_ok). A blanket header would also be applied to 404s,
	# which makes the browser remember "this file does not exist" for 30
	# days — meaning a model dropped into the bind-mount AFTER the page was
	# first opened never becomes visible until a hard refresh / cache wipe.
	@models_ok {
		path /models/*
		status 200
	}
	header @models_ok Cache-Control "public, max-age=2592000, immutable"

	handle /models/* {
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
